{
	"manifest_version": 2,
	"name": "Zotero AI Sidebar",
	"version": "1.7.4",
	"description": "在 Zotero 右侧栏内嵌 ChatGPT / DeepSeek 网页版，可随时切换：划词直接把选中文字送进当前对话，点面板标题栏的纸飞机按钮把当前论文 PDF 送进对话（不切页），条目一键提问。",
	"author": "WorkBuddy",
	"homepage_url": "https://github.com/baijiyunze/zotero-chatgpt-sidebar",
	"icons": {
		"48": "content/icons/ai-48.svg",
		"96": "content/icons/ai-96.svg"
	},
	"applications": {
		"zotero": {
			"id": "zoterogpt-sidebar@workbuddy.local",
			"update_url": "https://raw.githubusercontent.com/baijiyunze/zotero-chatgpt-sidebar/main/update.json",
			"strict_min_version": "7.0",
			"strict_max_version": "10.*"
		}
	}
}
